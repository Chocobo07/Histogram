import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# -------------------------------
# Load dataset
# -------------------------------
FILE_PATH = r"C:\Users\A15 TUF GAMING\Downloads\archive\4_malicious_ips.csv"
df = pd.read_csv(FILE_PATH)

print("Columns in dataset:")
print(df.columns)

# -------------------------------
# Data preparation
# -------------------------------
reputation = df["Reputation_Score"].dropna()

# -------------------------------
# Normal curve function
# -------------------------------
def normal_curve(ax, data):
    mu = data.mean()
    sigma = data.std()

    x = np.linspace(data.min(), data.max(), 100)
    y = (1/(sigma*np.sqrt(2*np.pi))) * np.exp(-0.5*((x-mu)/sigma)**2)

    ax.plot(x, y, color="red", linewidth=2)

# -------------------------------
# 1. Main Histogram (Reputation Score)
# -------------------------------
plt.figure(figsize=(7, 4))

plt.hist(reputation, bins=30, color='skyblue', edgecolor='black')
plt.title("Distribution of Malicious IP Reputation Scores")
plt.xlabel("Reputation Score")
plt.ylabel("Frequency")

normal_curve(plt.gca(), reputation)

plt.tight_layout()
plt.show()

# -------------------------------
# 2. Top Countries with Malicious IPs
# -------------------------------
top_countries = df["Country"].value_counts().head(10)

