# -------------------------------
# 4. Country vs Reputation 
# -------------------------------
high_risk = df[df["Reputation_Score"] > df["Reputation_Score"].median()]["Reputation_Score"]
low_risk = df[df["Reputation_Score"] <= df["Reputation_Score"].median()]["Reputation_Score"]

plt.figure(figsize=(7, 4))

plt.hist(low_risk, bins=20, alpha=0.6, label="Low Risk", color="blue", edgecolor="black")
plt.hist(high_risk, bins=20, alpha=0.6, label="High Risk", color="red", edgecolor="black")

plt.title("Malicious IP Risk Level Distribution")
plt.xlabel("Reputation Score")
plt.ylabel("Frequency")
plt.legend()

plt.tight_layout()
plt.show()
